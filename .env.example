# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에서 제외된다.
# 실행: node --env-file=.env --import tsx src/cli/main.ts <명령>   (또는 npm run cli -- <명령>)

# Sandbox 키 (필수). 형식 SB{10자}.{32자}. 파트너 포털 > 설정 > API Key 에서 발급.
SWEETBOOK_SANDBOX_API_KEY=

# Live 키 (선택). 스위트북과 사업 협의 후 열린다. 없으면 --env live 는 기동 시점에 실패한다.
SWEETBOOK_LIVE_API_KEY=

# 작업 상태 파일 위치 (선택, 기본 ./jobs)
# BOOKPRINT_JOBS_DIR=./jobs

# 기저 URL 교체 (선택, sandbox 에서만 적용). 로컬 모의 서버로 시험할 때 쓴다.
# BOOKPRINT_BASE_URL_OVERRIDE=http://127.0.0.1:8080/v1
